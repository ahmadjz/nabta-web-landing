---
import "../styles/global.css";
// Self-hosted fonts (no Google-Fonts CDN). Vite bundles the woff2 into _astro/
// and base-prefixes the URLs automatically. Subset-scoped (arabic-*/latin-*) keeps
// the payload down; @fontsource ships font-display: swap by default — keep it.
// Body: Cairo (ar+latin). Display: Fraunces Variable (Latin) + Tajawal (Arabic).
import "@fontsource/cairo/arabic-400.css";
import "@fontsource/cairo/arabic-500.css";
import "@fontsource/cairo/arabic-700.css";
import "@fontsource/cairo/latin-400.css";
import "@fontsource/cairo/latin-500.css";
import "@fontsource/cairo/latin-700.css";
import "@fontsource-variable/fraunces"; // Latin display (variable weight axis)
import "@fontsource/tajawal/arabic-500.css";
import "@fontsource/tajawal/arabic-700.css";
import "@fontsource/tajawal/arabic-800.css";

import { ClientRouter } from "astro:transitions";
import { DIR, getDict, type Locale } from "../i18n";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  /** Page-pair key (drives the language toggle + hreflang). "notfound" has no pair. */
  pageKey: string;
  /** The page's locale — passed explicitly so html lang/dir is deterministic. */
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
}

const { pageKey, locale, title, description, noindex = false } = Astro.props;
const dir = DIR[locale];
const t = getDict(locale);
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    {
      /* Inline PRE-PAINT motion script (LPV2-02). Runs synchronously during head
       parse — before the body paints and before reveal.ts sets data-motion-ready —
       so it (a) marks JS available (reveals the JS-only motion toggle, no dead
       button on a no-JS render) and (b) stamps html[data-motion="off"] from the
       persisted preference, so a reload of a motion-off page can't flash motion.
       Kept tiny + dependency-free; the full wiring lives in motion-pref.ts. */
    }
    <script is:inline>
      (function () {
        const el = document.documentElement;
        el.setAttribute("data-js", "");
        try {
          if (localStorage.getItem("nabta-motion") === "off")
            el.setAttribute("data-motion", "off");
        } catch {
          /* localStorage blocked — motion defaults on, OS reduce still applies */
        }
      })();
    </script>
    <BaseHead
      pageKey={pageKey}
      locale={locale}
      title={title}
      description={description}
      noindex={noindex}
    />
    {
      /* Client-side routing — fade only (Astro's default cross-page transition;
       NO `transition:animate="slide"` anywhere, so there is no directional/RTL-
       unsafe page slide). It makes `astro:page-load`/`astro:before-swap` fire on
       every navigation, which is what re-arms reveal.ts/count-up.ts after a swap
       (LVR-03). Under prefers-reduced-motion the router skips the animation. The
       Header/Wordmark are deliberately NOT `transition:persist` (a persisted RTL
       header / wrong-face Wordmark on an LTR page is the failure — H6). */
    }
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <a
      href="#main"
      class="sr-only rounded-md bg-primary px-4 py-2 text-white focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50"
    >
      {t.skipToContent}
    </a>
    <Header locale={locale} pageKey={pageKey} />
    {
      /* tabindex="-1" makes the skip-link target focusable: activating the
       skip-link moves focus here (WCAG 2.4.1), and this must survive a
       ClientRouter swap — asserted by the preview-smoke headless leg (LVR-03).

       transition:name="page-canvas" (LPV2-04): give the main region its OWN named
       view-transition group so it crossfades independently (Astro's default
       animation IS a fade — no directional slide). Deliberately on <main>, a
       LOCALE-INVARIANT element (identical tag/id/attrs on every page + locale),
       NOT the Header/Wordmark: a `transition:name` SNAPSHOTS + crossfades (it does
       NOT `transition:persist` a live node), so — unlike the H6 regression — it can
       never leave a stale RTL header / wrong-face Wordmark on an LTR page. The
       crossfade is neutralised under reduce-motion (Astro self-skips) AND the
       in-page toggle (the `::view-transition-*` fallback in global.css). */
    }
    <main id="main" tabindex="-1" class="flex-1" transition:name="page-canvas">
      <slot />
    </main>
    <Footer locale={locale} />
    {
      /* Motion machinery — bundled to same-origin /_astro (module, deferred). All
       re-init on `astro:page-load`, so they re-fire after a ClientRouter swap
       (LVR-03). Inert until a section emits [data-reveal]/[data-count-up]/
       [data-hero-signature]. motion-pref.ts (LPV2-02) re-applies the persisted
       motion preference across swaps + wires the toggle button. ALL client scripts
       are consolidated into THIS single module block, so Astro emits one shared
       motion chunk (+ the `motion` vendor chunk for hero-signature.ts, the scoped
       ban-lift island, LPV2-03 / ADR-41) rather than a script per file. */
    }
    {
      /* ORDER MATTERS: motion-pref.ts MUST be imported first. Every module here
       registers its init on the same document `astro:page-load`, and listeners fire
       in registration order — motion-pref.ts re-stamps html[data-motion] from storage
       on a swap (the swapped-in <html> arrives without it), and the islands below read
       that attr via isEffectiveMotionOff(). Reordering would let an island read a
       stale/absent attr on the first swap → a brief reduced-motion violation. */
    }
    <script>
      import "../scripts/motion-pref.ts";
      import "../scripts/reveal.ts";
      import "../scripts/count-up.ts";
      import "../scripts/hero-signature.ts";
      import "../scripts/magnetic.ts";
    </script>
  </body>
</html>
