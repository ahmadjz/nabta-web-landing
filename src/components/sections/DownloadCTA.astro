---
/**
 * DownloadCTA (LVR-07 · restyled LPV2-06) — the full-bleed forest band.
 * `Section tone="forest"` paints `bg-primary-900 text-cream` AND adds
 * `.forest-band`, which switches the `:focus-visible` ring to cream (global.css)
 * so a focused control stays visible on the dark ground. A low-opacity
 * `MeshGradient` + a corner `LeafCluster` wash the band (decorative, aria-hidden,
 * via the Section `motif` slot).
 *
 * Contrast (LPV2-01 locked pair `cream`-on-`primary-900` ≈ 4.53:1): the heading is
 * FULL `cream-50`; body + note sit at 90% / 80% cream, ABOVE the locked pair's
 * headroom (raising alpha only improves contrast — Lighthouse a11y=100 is the
 * authority). The ghost secondary stays the LIGHT variant (dark-on-light + a cream
 * ring), never clay — white-on-clay (~3.4:1) fails AA on this band.
 *
 * The disabled "coming soon" CTA reuses `DownloadButton` UNCHANGED (its
 * `data-download-cta`/`data-state="disabled"` contract is asserted by
 * marketing.test + contact-cta.test). LPV2-06 opts it into the LPV2-04 magnetic
 * pull via the SAME two-wrapper shape as the Hero: the OUTER span is the Reveal
 * stagger's direct child (owns the CSS entrance transform), the INNER
 * `[data-magnetic]` span owns the WAAPI pull transform — separate elements so the
 * two never fight over one `transform`. The pull is a `pointer:fine` desktop
 * nicety: a no-op on touch and static under reduce-motion / the in-page toggle
 * (magnetic.ts gates on `isEffectiveMotionOff()`), and never moves the disabled
 * control's role/label.
 *
 * MeshGradient gets a distinct `idSuffix` so its gradient IDs don't collide with
 * the Hero's AmbientBackdrop MeshGradient on the same page (duplicate-id a11y fail).
 */
import Section from "../Section.astro";
import Reveal from "../Reveal.astro";
import Button from "../Button.astro";
import DownloadButton from "../DownloadButton.astro";
import MeshGradient from "../motifs/MeshGradient.astro";
import LeafCluster from "../motifs/LeafCluster.astro";
import { getDict, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale).marketing.download;
---

<Section tone="forest" width="prose">
  {
    /* Soft mesh wash + corner leaf — decorative, low-opacity, clipped by Section. */
  }
  <MeshGradient
    slot="motif"
    idSuffix="cta"
    class="absolute inset-0 h-full w-full opacity-[0.16]"
  />
  <LeafCluster
    slot="motif"
    class="absolute -bottom-8 -end-8 w-56 text-primary-700/50 [dir=rtl]:-scale-x-100"
  />

  <div class="text-center">
    <Reveal
      as="h2"
      mode="slide-y"
      class="text-balance font-display text-h2 font-semibold text-cream-50"
    >
      {t.heading}
    </Reveal>
    <Reveal mode="slide-y" class="mt-4">
      <p class="mx-auto max-w-xl text-pretty text-lead text-cream-50/90">
        {t.body}
      </p>
    </Reveal>

    <Reveal
      mode="stagger"
      class="mt-[var(--space-stack)] flex flex-wrap items-center justify-center gap-4"
    >
      {
        /* Magnetic primary CTA (LPV2-04 hook, opted in at LPV2-06): OUTER span =
           the stagger's entrance-transform child, INNER [data-magnetic] span = the
           pointer-pull transform. Disabled coming-soon contract is untouched. */
      }
      <span class="inline-flex">
        <span class="inline-flex" data-magnetic>
          <DownloadButton locale={locale} />
        </span>
      </span>
      <Button variant="ghost" href="#contact">{t.secondaryLabel}</Button>
    </Reveal>

    <p class="mt-4 text-small text-cream-50/80">{t.note}</p>
  </div>
</Section>
